# Copy to .env.local only if you need to point the dev frontend somewhere other than the local backend.
# Read by src/lib/api.js at BUILD time. Anything prefixed VITE_ is shipped to the browser — never put a secret here.

# The backend. Unset = http://localhost:8000. Production (Render Static Site): the backend's public URL.
VITE_API_URL=http://localhost:8000

# Where uploaded images/music are served from. Unset = the backend (it serves /uploads in local-storage mode).
# Production: the Cloudflare R2 bucket's public URL (r2.dev subdomain or custom domain), no trailing path.
# VITE_UPLOADS_URL=https://pub-xxxxxxxx.r2.dev
