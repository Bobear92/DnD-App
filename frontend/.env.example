# Copy to .env.local only if you need to point the dev frontend somewhere other than the local backend.
# Read by src/lib/api.js at BUILD time; unset = http://localhost:8000.
# In production (Render Static Site) set this as an environment variable to the backend's public URL.
# Anything prefixed VITE_ is shipped to the browser — never put a secret here.
VITE_API_URL=http://localhost:8000
